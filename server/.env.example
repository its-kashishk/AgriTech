# Copy this file to ".env" (same folder) and fill in YOUR values. Never commit ".env".
PORT=8000
NODE_ENV=development

# MongoDB Atlas: Database > Connect > Drivers. Use the DATABASE USER's password (URL-encode special characters).
# Keep the database name /AgriTech before the "?".
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.eybnl67.mongodb.net/AgriTech?retryWrites=true&w=majority

# Long random string (16+ chars). Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# Allowed browser origin(s) for CORS, comma separated
CLIENT_URL=http://localhost:5173

# OpenWeatherMap (https://home.openweathermap.org/api_keys). Leave empty to disable weather.
OPENWEATHER_API_KEY=
WEATHER_CACHE_MINUTES=15
# Set true ONLY to show clearly-labelled DEMO weather when no key is configured
OPENWEATHER_DEMO=false

# Used only by "npm run seed:admin"
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-before-running-seed
